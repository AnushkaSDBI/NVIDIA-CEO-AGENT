# Copy this file to ".env" and fill in your values (or set these as system
# environment variables). The .env file is gitignored and never committed.

# --- SEC EDGAR (required, or SEC returns HTTP 403) ---
# SEC requires a descriptive User-Agent with a real contact email.
SEC_USER_AGENT=AI-CEO-Project your.real.email@example.com

# --- Reddit consumer sentiment (optional) ---
# Path A: PRAW OAuth app (https://www.reddit.com/prefs/apps -> "script" type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-ceo-research/0.1
# Path B: keyless RSS feed token (https://www.reddit.com/prefs/feeds/)
REDDIT_FEED_USER=
REDDIT_FEED_TOKEN=

# --- GitHub ecosystem (optional; raises rate limit) ---
GITHUB_TOKEN=

# --- Hugging Face (optional; faster model downloads, higher rate limit) ---
HF_TOKEN=
